// Esquema — módulo de gestión de pagos
// Documentación: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SUPERADMIN
  ADMIN
  COBRADOR
}

enum EstadoContenedor {
  ACTIVO
  COMPLETADO
  FACTURADO
}

enum OrigenEjecucion {
  CRON
  MANUAL
}

model Usuario {
  id                  String   @id @default(cuid())
  usuario             String   @unique
  passwordHash        String
  nombre              String?
  rol                 Rol      @default(ADMIN)
  debeCambiarPassword Boolean  @default(false)
  verTodosPagos       Boolean  @default(false)
  permisos            String[] @default([]) // ver los permisos disponibles en src/lib/permisos.ts
  creadoEn            DateTime @default(now())

  cobradorId String?   @unique
  cobrador   Cobrador? @relation("UsuarioDeCobrador", fields: [cobradorId], references: [id])

  cobradoresCreados      Cobrador[]      @relation("CobradorCreadoPor")
  cobradoresActualizados Cobrador[]      @relation("CobradorActualizadoPor")
  contenedoresCreados      Contenedor[]  @relation("ContenedorCreadoPor")
  contenedoresActualizados Contenedor[]  @relation("ContenedorActualizadoPor")
  pagosCreados      Pago[]              @relation("PagoCreadoPor")
  pagosActualizados Pago[]              @relation("PagoActualizadoPor")
  pagosCobradorAsignados Pago[]         @relation("PagoCobradorAsignadoPor")
  pagosDevueltos         Pago[]         @relation("PagoDevueltoPor")
  tiposCambioCreados      TipoCambioDia[] @relation("TipoCambioCreadoPor")
  tiposCambioActualizados TipoCambioDia[] @relation("TipoCambioActualizadoPor")
  cronEjecuciones CronEjecucion[] @relation("CronEjecucionUsuario")
  actividades     RegistroActividad[]
}

model Cobrador {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  pagos     Pago[]
  usuarioCuenta Usuario? @relation("UsuarioDeCobrador")

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("CobradorCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("CobradorActualizadoPor", fields: [actualizadoPorId], references: [id])
}

model Contenedor {
  id                 String           @id @default(cuid())
  nombre             String
  codigo             String?          @unique // ej. MSKU9395463 — puede quedar sin asignar de momento
  saldoInicial       Decimal          @default(0) @db.Decimal(12, 2)
  monedaSaldoInicial String           @default("USD")
  fechaInicio        DateTime
  inicioBanco        DateTime? // si existe, solo pertenecen a este contenedor los pagos posteriores a este instante (orden del banco)
  totalFactura       Decimal          @db.Decimal(12, 2)
  monedaTotalFactura String           @default("USD")
  estado             EstadoContenedor @default(ACTIVO)
  pagos              Pago[]

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("ContenedorCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("ContenedorActualizadoPor", fields: [actualizadoPorId], references: [id])
}

model TipoCambioDia {
  fecha     DateTime @id @db.Date
  usdPorEur Decimal  @db.Decimal(10, 4)

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("TipoCambioCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("TipoCambioActualizadoPor", fields: [actualizadoPorId], references: [id])
}

model CronEjecucion {
  id          String          @id @default(dbgenerated("gen_random_uuid()::text"))
  tipo        String          @default("tipoCambioBCE")
  origen      OrigenEjecucion
  ejecutadoEn DateTime        @default(now())
  exitoso     Boolean
  mensajeError String?
  fechaDesde  DateTime?       @db.Date
  totalFichero Int?
  nuevos      Int?
  actualizados Int?
  existentes  Int?
  ultimaFecha DateTime?       @db.Date
  pagosRecalculados Int?

  usuarioId String?
  usuario   Usuario? @relation("CronEjecucionUsuario", fields: [usuarioId], references: [id])

  @@index([origen, ejecutadoEn])
}

model RegistroActividad {
  id         String   @id @default(dbgenerated("gen_random_uuid()::text"))
  usuarioId  String?
  usuario    Usuario? @relation(fields: [usuarioId], references: [id])
  accion     String
  entidad    String
  entidadId  String?
  detalle    String?
  creadoEn   DateTime @default(now())

  @@index([creadoEn])
}

model RevolutToken {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  actualizadoEn DateTime @default(now())
}

model SabadellSesion {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  sessionId     String
  accountUids   String[] // puede haber varias cuentas autorizadas (p.ej. una en EUR y otra en USD)
  validaHasta   DateTime
  actualizadoEn DateTime @default(now())
}

model Pago {
  id           String      @id @default(cuid())
  contenedorId String?
  contenedor   Contenedor? @relation(fields: [contenedorId], references: [id])
  cobradorId   String?
  cobrador     Cobrador?   @relation(fields: [cobradorId], references: [id])
  fecha        DateTime    @db.Date
  persona      String
  importeEur   Decimal?    @db.Decimal(12, 2)
  importeUsd   Decimal?    @db.Decimal(12, 2)
  tasaCambio   Decimal?    @db.Decimal(10, 4)
  fechaTasaCambio DateTime? @db.Date
  monedaOriginal String     @default("EUR")
  banco        String      @default("Revolut")
  idOrigen     String?     @unique
  fechaHoraBanco DateTime? // instante del pago según el banco; sirve para ordenar y para cortar entre contenedores

  devuelto       Boolean   @default(false) // devolución al cliente; no cuenta en los totales recibidos
  devueltoEn     DateTime?
  devueltoPorId  String?
  devueltoPor    Usuario?  @relation("PagoDevueltoPor", fields: [devueltoPorId], references: [id])
  devueltoNota   String?   // motivo de la devolución, lo escribe el superadministrador

  cobradorAsignadoPorId String?
  cobradorAsignadoPor   Usuario?  @relation("PagoCobradorAsignadoPor", fields: [cobradorAsignadoPorId], references: [id])
  cobradorAsignadoEn    DateTime?

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("PagoCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("PagoActualizadoPor", fields: [actualizadoPorId], references: [id])
}
